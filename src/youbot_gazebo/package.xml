<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>youbot_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic digital twin: strawberry-greenhouse world + YouBot spawn, driven by the ROS 2 control stack.</description>
  <maintainer email="josiasarmand40@gmail.com">Franck Armand Josias Einstein</maintainer>
  <license>MIT</license>

  <exec_depend>youbot_control</exec_depend>
  <exec_depend>youbot_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
