<?xml version="1.0"?>
<!--
  Gazebo (Harmonic) URDF for the YouBot digital twin. Same body as the RViz
  visual URDF, plus what Gazebo needs: inertials, a base collision, a gpu_lidar
  sensor, and two model plugins:
    * VelocityControl   : applies /cmd_vel (body-frame vx, vy, wz) to the base,
                          so the mecanum strafes without simulating rollers.
    * OdometryPublisher : ground-truth /odom in the map frame (matches the
                          perfect-localisation assumption of the control stack).
  Frame convention: +X forward (toward the arm), +Y left, +Z up.
-->
<robot name="youbot">
  <material name="kuka_orange"><color rgba="0.95 0.50 0.10 1"/></material>
  <material name="dark"><color rgba="0.14 0.14 0.16 1"/></material>
  <material name="grey"><color rgba="0.42 0.42 0.45 1"/></material>
  <material name="plate"><color rgba="0.30 0.30 0.33 1"/></material>

  <!-- Base chassis + rear carrying plate -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.11"/>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.9" iyz="0" izz="1.2"/>
    </inertial>
    <!-- No collision: the base is driven kinematically (VelocityControl) and
         localisation is ground-truth, so the robot is a "ghost" that A* + the
         reactive lidar brake keep off the gutters. This prevents any physics
         contact from wedging or tipping it (as happened with crates in aisles). -->
    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry><box size="0.57 0.36 0.10"/></geometry>
      <material name="kuka_orange"/>
    </visual>
    <visual>
      <origin xyz="-0.12 0 0.17"/>
      <geometry><box size="0.28 0.34 0.03"/></geometry>
      <material name="plate"/>
    </visual>
  </link>

  <!-- Four mecanum wheels (fixed: the base is driven kinematically) -->
  <link name="wheel_fl">
    <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="j_fl" type="fixed"><parent link="base_link"/><child link="wheel_fl"/><origin xyz="0.228 0.178 0.05"/></joint>

  <link name="wheel_fr">
    <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="j_fr" type="fixed"><parent link="base_link"/><child link="wheel_fr"/><origin xyz="0.228 -0.178 0.05"/></joint>

  <link name="wheel_rl">
    <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="j_rl" type="fixed"><parent link="base_link"/><child link="wheel_rl"/><origin xyz="-0.228 0.178 0.05"/></joint>

  <link name="wheel_rr">
    <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="j_rr" type="fixed"><parent link="base_link"/><child link="wheel_rr"/><origin xyz="-0.228 -0.178 0.05"/></joint>

  <!-- Simplified folded arm at the front -->
  <link name="arm_base">
    <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.035" length="0.10"/></geometry><material name="kuka_orange"/></visual>
  </link>
  <joint name="j_arm" type="fixed"><parent link="base_link"/><child link="arm_base"/><origin xyz="0.17 0 0.16"/></joint>

  <link name="arm_seg">
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
    <visual><origin xyz="0.07 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.026" length="0.16"/></geometry><material name="grey"/></visual>
  </link>
  <joint name="j_arm2" type="fixed"><parent link="arm_base"/><child link="arm_seg"/><origin xyz="0 0 0.10"/></joint>

  <!-- Lidar sensor mount, centred on the base, 0.20 m up -->
  <link name="lidar">
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.05"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="j_lidar" type="fixed"><parent link="base_link"/><child link="lidar"/><origin xyz="0 0 0.20"/></joint>

  <!-- Camera on a short mast, forward-facing, to inspect the plant rows -->
  <link name="mast">
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <visual><origin xyz="0 0 0.19"/><geometry><cylinder radius="0.015" length="0.38"/></geometry><material name="grey"/></visual>
  </link>
  <joint name="j_mast" type="fixed"><parent link="base_link"/><child link="mast"/><origin xyz="0.22 0 0.16"/></joint>

  <link name="camera">
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><geometry><box size="0.03 0.09 0.03"/></geometry><material name="dark"/></visual>
  </link>
  <!-- 0.60 m up, level: the ripe fruit sits at ~0.85-0.95 m (above the camera),
       so a level (not downward) view frames the plant rows instead of the floor -->
  <joint name="j_camera" type="fixed"><parent link="base_link"/><child link="camera"/><origin xyz="0.24 0 0.60" rpy="0 0 0"/></joint>

  <!-- ==================== Gazebo-specific ==================== -->

  <!-- Gravity off: with no collision the base would otherwise fall through the
       floor before the first /cmd_vel arrives. VelocityControl then holds it in
       the plane (vz = roll = pitch = 0), so it glides level and never tips. -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>

  <!-- 360-beam 2D lidar, matches sim_node: -pi..pi, 12 m, 10 Hz -->
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <gz_frame_id>lidar</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- RGB camera for ripe-strawberry detection -> /camera/image + camera_info.
       Attached to base_link with an explicit pose (NOT to the 'camera' link):
       sdformat drops sensors on fixed-joint links that carry a rotation during
       lumping, so we mount it here directly, like the working lidar. The pose
       matches j_camera + j_mast (0.24 forward, 0.55 up, tipped 0.15 rad down). -->
  <gazebo reference="base_link">
    <sensor name="camera" type="camera">
      <pose>0.24 0 0.60 0 0 0</pose>
      <topic>camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
      </camera>
      <gz_frame_id>camera</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Drive the base directly from /cmd_vel (body frame): true mecanum strafe -->
  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- Ground-truth odometry in the map frame -> /odom + map->base_link TF -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf_gz</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>
</robot>
