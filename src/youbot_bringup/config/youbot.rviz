Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
  - Class: rviz_common/Views
    Name: Views
    Expanded: false
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Color Scheme: map
      Topic:
        Value: /map
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.06
      Style: Points
      Color: 255; 85; 0
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Color: 25; 255; 0
      Line Width: 0.05
      Topic:
        Value: /plan
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Crates
      Enabled: true
      Topic:
        Value: /crate_markers
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 1
      Topic:
        Value: /odom
        Reliability Policy: Best Effort
      Shape:
        Value: Arrow
        Color: 0; 170; 255
        Shaft Length: 0.4
        Head Length: 0.2
    - Class: rviz_default_plugins/Image
      Name: CameraRobot
      Enabled: true
      Topic:
        Value: /camera/detections
        Reliability Policy: Reliable
      Normalize Range: true
    # What the ripeness threshold actually kept: white = counted as fruit.
    # Turn it on when detections look wrong -- the mask says at a glance
    # whether the threshold is off or the camera is simply not on a row.
    - Class: rviz_default_plugins/Image
      Name: RipeMask
      Enabled: false
      Topic:
        Value: /camera/ripe_mask
        Reliability Policy: Reliable
      Normalize Range: true
    - Class: rviz_default_plugins/MarkerArray
      Name: TruthVsBelief
      Enabled: true
      Topic:
        Value: /truth_markers
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Harvest
      Enabled: true
      Topic:
        Value: /harvest_markers
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 16
      Pitch: 1.2
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 800
  Width: 1200
