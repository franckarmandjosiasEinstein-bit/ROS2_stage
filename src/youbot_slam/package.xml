<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>youbot_slam</name>
  <version>0.1.0</version>
  <description>Level-3 autonomy: homemade online SLAM (drift injection + correlative scan matching) plus a slam_toolbox comparison setup.</description>
  <maintainer email="josiasarmand40@gmail.com">Franck Armand Josias Einstein</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>youbot_control</depend>
  <!-- dataset_capture reads worlds/berries.yaml, the ground-truth
       catalogue the world generator writes. -->
  <depend>youbot_gazebo</depend>
  <!-- the launch files read config/youbot_params.yaml and, on shutdown,
       scripts/kill_sim.sh out of this package's share directory. -->
  <exec_depend>youbot_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
