<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>youbot_commissioning</name>
  <version>0.1.0</version>
  <description>Staged bring-up acceptance tests (0-9) for taking the YouBot
    harvesting stack from simulation to a real greenhouse. Each stage is a
    runnable test with a written procedure, a numeric pass/fail criterion and
    a archived report.</description>
  <maintainer email="josiasarmand40@gmail.com">Franck Armand Josias Einstein</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
