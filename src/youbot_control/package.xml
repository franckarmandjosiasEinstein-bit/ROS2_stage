<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>youbot_control</name>
  <version>0.1.0</version>
  <description>
    Autonomous control for a KUKA YouBot in a smart-agriculture scenario:
    lidar occupancy mapping, A* planning, pure-pursuit mecanum navigation,
    scan-matching localization and a mission orchestrator. Ported from a
    validated Webots controller.
  </description>
  <maintainer email="josiasarmand40@gmail.com">Franck Armand Josias Einstein</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
