<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>youbot_webots</name>
  <version>0.1.0</version>
  <description>webots_ros2 integration for the YouBot: driver plugin, URDF device map and launch.</description>
  <maintainer email="josiasarmand40@gmail.com">Franck Armand Josias Einstein</maintainer>
  <license>MIT</license>

  <exec_depend>webots_ros2_driver</exec_depend>
  <exec_depend>youbot_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
